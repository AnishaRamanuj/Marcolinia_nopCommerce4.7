						<li><i class="ri-mail-line"></i> customercare@marcolinia.com</li>
						<li><i class="ri-phone-line"></i> 800-92929</li>
						<li><i class="ri-phone-line"></i> 800-92929</li>
					</ul>
					<div class="social-media">
						<div class="f_icons mb-2">><i class="fa fa-envelope-o"></i> customercare@marcolinia.com</div>
						<div class="f_icons mb-2"><i class="fa fa-phone"></i> 800-92929</div>
						<div class="f_icons"><i class="fa fa-phone"></i> 04--2977792</div>
					</div>
				</div>
				<div class="col">
					<div class="footer_heading">
						<h4 class="ftr__title">My account</h4>
					</div>
					<ul class="footer_list">
						<li>My account</li>
						<li>Orders</li>
						<li>Shopping cart</li>
						<li>Search</li>
						<li>New products</li>
					</ul>
				</div>
				<div class="col">
